# ─── Site ─────────────────────────────────────────────────────────────────
# Public base URL — used for metadataBase, canonical, OG, sitemap, llms.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_UPWORK_URL=https://www.upwork.com/freelancers/abban
NEXT_PUBLIC_AUTHOR_URL=https://www.upwork.com/freelancers/abban

# ─── Database (libSQL / Turso) ──────────────────────────────────────────────
# Leave unset for a local SQLite file under .data/citegrade.db (dev).
# For production, create a free Turso DB: https://turso.tech
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-turso-token

# ─── Stripe (billing) ───────────────────────────────────────────────────────
# Without these, upgrade uses a dev-stub that flips the plan with no charge.
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_PRO=price_xxx          # $29/mo recurring price ID
# STRIPE_PRICE_AGENCY=price_xxx       # $79/mo recurring price ID

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Without this, magic links + alerts are logged to the server console.
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Citegrade <hello@citegrade.dev>

# ─── OAuth social login ─────────────────────────────────────────────────────
# When set, "Continue with GitHub/Google" buttons appear on the auth pages.
# GitHub: https://github.com/settings/developers (callback: <site>/api/auth/oauth/github/callback)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials (callback: <site>/api/auth/oauth/google/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Admin ──────────────────────────────────────────────────────────────────
# Comma-separated emails granted admin access to /admin (platform analytics).
# ADMIN_EMAILS=you@example.com

# ─── Cron ───────────────────────────────────────────────────────────────────
# Protects /api/cron/rescan. Vercel Cron sends this automatically when set.
# CRON_SECRET=some-long-random-string

# ─── Dev only ───────────────────────────────────────────────────────────────
# Allow auditing localhost / private IPs (self-audit). Never set in production.
# CITEGRADE_ALLOW_PRIVATE=1
